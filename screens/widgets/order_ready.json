{
  "title": "Order ready call-out",
  "description": "When an order is marked ready",
  "kind": "popup",
  "trigger": "order_ready",
  "icon": "M6 8a6 6 0 0 1 12 0c0 7 3 8 3 8H3s3-1 3-8 M10 20a2 2 0 0 0 4 0",
  "color": "#3DD68C",
  "template": "screens/popups/order_ready.html",
  "context": "screens.popups.order_ready",
  "live": [
    "popups"
  ],
  "params": {
    "style": {
      "type": "choice",
      "options": [
        "full",
        "banner"
      ],
      "default": "full",
      "label": "Style",
      "help": "Full screen, or a banner along the bottom"
    },
    "seconds": {
      "type": "int",
      "default": 6,
      "min": 2,
      "max": 60,
      "unit": "s",
      "label": "Show for"
    },
    "channel": {
      "type": "string",
      "default": "",
      "source": "audio:voice",
      "label": "Chime on",
      "help": "A voice channel from the Audio tab"
    },
    "speak": {
      "type": "bool",
      "default": true,
      "label": "Read it out",
      "help": "Say the name and number out loud"
    }
  }
}
