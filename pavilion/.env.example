# Copy to pavilion/.env and fill in. Never commit the real file.

# "production" switches to Postgres, DEBUG off, Redis and S3 media. Anything else = local dev (SQLite).
ENVIRONMENT=development
SECRET_KEY=change-me   # python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
APP_DOMAIN=pavilion.example.com

# Postgres (production). docker-compose.yml brings its own, with a generated password: nothing to set. To use another
# database instead (e.g. one Dokploy manages: its internal connection URL), give its connection string:
# DATABASE_URL=postgres://pavilion_user:change-me@my-postgres:5432/pavilion_db
# Outside Docker, without DATABASE_URL: the parts (the bundled database's name and user can be changed here too)
POSTGRES_DB=pavilion_db
POSTGRES_USER=pavilion_user
POSTGRES_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# Redis (required in production: shared cache + live updates between workers)
REDIS_URL=redis://redis:6379/0

# Media in a RustFS / S3-compatible bucket (production)
RUSTFS_ENDPOINT_URL=http://rustfs:9000
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_BUCKET=pavilion-media
RUSTFS_REGION=us-east-1
RUSTFS_PUBLIC_URL=media.example.com/pavilion-media
RUSTFS_PUBLIC_PROTOCOL=https:

# Kitchen/POS devices must be registered (default: on in production, off otherwise)
# ENFORCE_DEVICE_CHECK=true

# The store's name, address, email, tax rate, time zone and music space are set in the admin: Settings > Store info.

# Square
# Square: Pavilion is one Square app (Square Developer Dashboard). Stores connect their own Square account on the
# admin's Payments page (OAuth); register https://<host>/square/oauth/callback as the app's OAuth redirect URL.
SQUARE_ENVIRONMENT=sandbox           # or production
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=           # the app's OAuth secret
# Development only, until a Square account is connected: a personal access token and its location
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=   # the webhook's signature key; subscribe it (https://<host>/square/webhook) to
                                # terminal.checkout.updated and device.code.paired

# Other services
# Email through listmonk. Usually set on the admin's Email page instead (these only fill in when it's empty);
# leave everything empty to only log emails.
LISTMONK_URL=
LISTMONK_API_USER=
LISTMONK_API_TOKEN=
LISTMONK_FROM_EMAIL=
# Delivery travel times: a Valhalla routing server and a Nominatim server (addresses to map points). Usually set on
# Settings > Store info; these only fill in. docker-compose.yml runs both and sets these for the web service:
# VALHALLA_URL=http://valhalla:8002
# GEOCODER_URL=http://nominatim:8080
# OpenStreetMap's public Nominatim (https://nominatim.openstreetmap.org) is allowed for light use only: read
# https://operations.osmfoundation.org/policies/nominatim/ before using it.
# The map of your area that Valhalla and Nominatim build from: a Geofabrik .osm.pbf link (pick the smallest region
# that covers your deliveries at https://download.geofabrik.de). Changing it later: remove the valhalla_data and
# nominatim_data volumes so they rebuild.
OSM_EXTRACT=https://download.geofabrik.de/north-america/canada/british-columbia-latest.osm.pbf
# The weatherapi.com key for screens: usually set on Store info too
WEATHER_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Extra hostnames (comma-separated), e.g. a temporary ngrok domain
# EXTRA_HOSTS=
# VAPID_CONTACT_EMAIL=restaurant@example.com   # when Store info has no email

# Bugsink error reporting (DSN is built in; override or set empty to disable)
# BUGSINK_DSN=
# BUGSINK_SEND_PII=true     # attach usernames/emails/IPs to error reports on this deployment

# Rate limit: requests per client (each browser session, else device) every THROTTLE_WINDOW seconds;
# past it they get a 429 until the window ends (pavilion/throttle.py). One address gets 10 times as many.
# THROTTLE_REQUESTS=60
# THROTTLE_WINDOW=10
